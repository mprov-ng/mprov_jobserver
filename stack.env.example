# Environment for dev-docker-compose.yml.  Copy this file to stack.env
# (which git ignores) and fill it in; never commit a real API key.
MPROV_URL=http://<mpcc address>
# An mPCC API key.  Leave it empty if the mPCC container writes
# /etc/mprov/apikey: start_server.sh sources that file, and it wins.
MPROV_APIKEY=
MPROV_ADDRESS=<this job server's address>
MPROV_MODS=repo-update image-update image-delete mprov-webserver dnsmasq libgenders
# Optional.  The CA certificate for an https MPROV_URL whose certificate is
# from a site or self-signed CA (a path inside the container), and how much
# to log: error, warning, info (the default) or debug.
#MPROV_CA_BUNDLE=/etc/mprov/mpcc-ca.pem
#MPROV_LOG_LEVEL=info
# Uncomment to run against an mPCC on another API version, for development
# and CI only; never in production.  Set it to exactly 1, and set it on the
# mPCC too: the mPCC turns its own check off only for the value 1, while the
# job server also accepts true, yes and anything but empty, 0, false and no.
#MPROV_SKIP_VERSION_CHECK=1
SYSTEMD_LOG_TARGET=console
TZ=America/New_York
