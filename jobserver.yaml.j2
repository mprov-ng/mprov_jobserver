- global:
    # This points to your mprov control center instance.
    # This URL should point to the internal IP address or hostname and include a trailing slash
    # e.g. "http://<IP of internal interface>/"
    
    mprovURL: {{env['MPROV_URL']}}
{#- The job server enrolls with the mPCC for a certificate of its own, with
    the token in MPROV_ENROLL_TOKEN or /etc/mprov/enroll_token, and keeps it
    in MPROV_TLS_DIR (default /var/lib/mprov/tls).  The shared API key is
    only a fallback until then, deprecated, and gone in 0.8.0
    (mprov_control_center#381). #}
{%- if env.get('MPROV_APIKEY') %}
    apikey: {{ env['MPROV_APIKEY'] | tojson }}
{%- endif %}
    # this is the interval which this jobserver will check in with the mPCC
    heartbeatInterval: 10
    # runonce: True # uncomment to run the jobserver once and exit.
    myaddress: {{env['MPROV_ADDRESS']}} # set this to the address of this jobserver.
{#- Optional settings, written only when their variable is set (#301).
    tojson quotes the value, and JSON is YAML. #}
{%- if env.get('MPROV_CA_BUNDLE') %}
    caBundle: {{ env['MPROV_CA_BUNDLE'] | tojson }}
{%- endif %}
{%- if env.get('MPROV_LOG_LEVEL') %}
    logLevel: {{ env['MPROV_LOG_LEVEL'] | tojson }}
{%- endif %}
    jobmodules: 
{%- for mod in env['MPROV_MODS'].split() %}
      - {{mod}}
{%- endfor %}


# include any plugin yamls.        
- !include plugins/*.yaml
